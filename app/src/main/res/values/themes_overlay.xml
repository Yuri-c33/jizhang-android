        <item name="jizhangSectionHeaderPaddingBottom">6dp</item>
        <item name="jizhangAppBarPadding">20dp</item>
        <item name="jizhangEmptyUseIcon">false</item>
        <item name="jizhangKeyCornerRadius">10dp</item>
        <item name="jizhangKeyBackgroundTint">?attr/colorSurfaceContainerLowest</item>
