    </style>

    <!--
        MD3 风格：只负责形状、间距与排版这类「结构」覆盖。
        具体颜色由 ThemeOverlay.Jizhang.Palette.* 提供，用户可在设置里切换配色。
        两层叠加的顺序是：结构层 → 配色层，因此这里不写任何颜色项。
    -->
    <style name="ThemeOverlay.Jizhang.Elegant" parent="">
        <item name="cardCornerRadiusStyle">28dp</item>
        <item name="jizhangCardContentPadding">16dp</item>
        <item name="jizhangScreenPadding">12dp</item>
        <item name="jizhangListHorizontalPadding">12dp</item>
        <item name="jizhangListBottomPadding">20dp</item>
        <item name="jizhangSectionSpacing">16dp</item>
        <item name="jizhangCardStrokeWidth">1dp</item>
        <item name="jizhangCardStrokeColor">?attr/colorOutlineVariant</item>
        <!-- MD3：页面用 surface，分组卡片用最亮的 surfaceContainerLowest，
             形成 Google 设置页那种「米色/浅灰页面 + 白色圆角卡片」的层次。 -->
        <item name="jizhangCardBackgroundColor">?attr/colorSurfaceContainerLowest</item>
        <item name="jizhangListSectionBackground">?attr/colorSurfaceContainerLowest</item>
        <item name="jizhangListSectionDividerColor">?attr/colorOutlineVariant</item>
        <item name="jizhangListSectionCornerRadius">28dp</item>
        <!-- MD3：每笔账是列表里独立浮起的圆角条子。 -->
        <item name="jizhangListItemBackground">?attr/colorSurfaceContainerLow</item>
        <item name="jizhangListItemCornerRadius">20dp</item>
        <item name="jizhangListItemStrokeWidth">0dp</item>
        <item name="jizhangListItemStrokeColor">@android:color/transparent</item>
        <item name="jizhangListItemMarginHorizontal">8dp</item>
        <item name="jizhangListItemMarginVertical">4dp</item>
        <item name="jizhangListItemVerticalPadding">14dp</item>
        <item name="jizhangRowVerticalPadding">14dp</item>
        <item name="jizhangListRowPadding">16dp</item>
        <item name="jizhangSectionHeaderPaddingTop">24dp</item>
        <item name="jizhangSectionHeaderPaddingBottom">10dp</item>
        <item name="jizhangAppBarPadding">24dp</item>
        <item name="jizhangEmptyUseIcon">true</item>
        <!-- 胶囊形按键：宽大于高时接近 Google 计算器的圆形键观感。 -->
        <item name="jizhangKeyCornerRadius">28dp</item>
        <!-- 键盘面板用一档灰，按键用亮表面色，两者拉开层次；按下由 MD3 状态层变深。 -->
        <item name="jizhangKeyBackgroundTint">?attr/colorSurfaceContainerHighest</item>
        <item name="jizhangKeypadBackground">?attr/colorSurfaceContainer</item>
        <item name="jizhangMonthSwitcherBackground">@drawable/bg_month_switcher_md3</item>
        <item name="jizhangMonthSwitcherPadding">4dp</item>
        <!-- 设置页卡片：白/近白卡片浮在页面底色之上 -->
        <item name="jizhangSettingsCardCornerRadius">28dp</item>
        <item name="jizhangSettingsCardMarginHorizontal">12dp</item>
        <item name="jizhangSettingsCardBackground">?attr/colorSurfaceContainerLowest</item>
        <item name="jizhangSettingsRowPadding">20dp</item>
        <item name="jizhangSettingsDividerColor">?attr/colorOutlineVariant</item>
        <item name="jizhangSettingsPageBackground">?attr/colorSurface</item>
    </style>

